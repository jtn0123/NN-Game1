<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Unity engine sources against Unity's API surface (.NET Standard 2.1). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CrystalCaves.Sim</AssemblyName>
    <RootNamespace>CrystalCaves.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Sim/**/*.cs" />
  </ItemGroup>
</Project>
